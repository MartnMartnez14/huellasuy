# Export these values in your shell or hosting dashboard; .env is not auto-loaded.
SECRET_KEY=
DATABASE_PATH=instance/huellasuy.db
PUBLIC_ORIGIN=http://127.0.0.1:5000
# TTL is deliberately fixed at 24 hours; changing it requires an ADR and tests.

# Enable only after database backup and email checks.
AUTH_ENABLED=0
ADMIN_EMAIL=
# HTTPS production must use 1; local HTTP development uses 0.
SESSION_COOKIE_SECURE=1
# Optional: absolute path to private Brevo JSON, outside repo/static.
BREVO_CONFIG_PATH=
